# Normalise line endings so Windows checkouts do not produce CRLF diffs.
* text=auto eol=lf

*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.rst   text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cff   text eol=lf
*.svg   text eol=lf
Makefile text eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.gz    binary
*.whl   binary
